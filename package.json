{
  "name": "pit",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~56.0.19",
    "@react-native-community/slider": "5.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~56.0.20",
    "expo-asset": "~56.0.22",
    "expo-audio": "~56.0.13",
    "expo-constants": "~56.0.23",
    "expo-file-system": "~56.0.9",
    "expo-image": "~56.0.12",
    "expo-image-manipulator": "~56.0.25",
    "expo-image-picker": "~56.0.24",
    "expo-sharing": "~56.0.25",
    "expo-splash-screen": "~56.0.14",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-video": "~56.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "ingest:venues": "node scripts/ingest-venues.mjs",
    "ingest:artists": "node scripts/ingest.mjs",
    "ingest:venue-photos": "node scripts/ingest-venue-photos.mjs",
    "ingest:famous-photos": "node scripts/ingest-famous-venue-photos.mjs",
    "ingest:details": "node scripts/ingest-artist-details.mjs",
    "ingest:fix-bios": "node scripts/fix-bios.mjs",
    "warm:youtube": "node scripts/warm-youtube-cache.mjs",
    "ingest:all": "node scripts/ingest-venues.mjs && node scripts/ingest-famous-venue-photos.mjs && node scripts/ingest-venue-photos.mjs && node scripts/ingest-artist-details.mjs && node scripts/fix-bios.mjs",
    "pipeline": "node --env-file=.env scripts/pipeline.mjs",
    "server": "node server/index.js",
    "integrity": "node scripts/integrity-check.mjs",
    "stress": "node scripts/stress.mjs",
    "benchmark:read": "node scripts/benchmark-read.mjs",
    "benchmark:recommendation": "node scripts/benchmark-recommendation.mjs",
    "benchmark:seed": "node scripts/seed-capacity-fixture.mjs",
    "backup": "node scripts/backup-db.mjs",
    "backup:verify": "node scripts/backup-db.mjs --verify",
    "build:web": "npm run split:catalog && expo export -p web",
    "test": "node scripts/run-tests.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run split:catalog && npm run test && npm run check:syntax && npm run check:architecture && npm run build:web",
    "split:catalog": "node scripts/split-catalog.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  }
